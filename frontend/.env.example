# Base URL de la API. Editando SOLO esta linea alternas entre entornos
# (reinicia Metro con Ctrl+C y `npx expo start` despues de cambiarla).

# Local - backend corriendo en tu maquina (default si la variable no existe):
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Render - produccion (descomenta y pon tu URL de servicio):
# EXPO_PUBLIC_API_URL=https://TU-SERVICIO.onrender.com/api/v1

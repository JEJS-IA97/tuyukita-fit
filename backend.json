{
  "project": {
    "name": "yukita-fit",
    "description": "Backend API para una aplicación móvil de gestión de ventas, gastos, costos de producción y flujo de dinero para yukita Fit.",
    "root_directory": "yukita-fit",
    "backend_directory": "yukita-fit/backend",
    "frontend_directory": "yukita-fit/frontend",
    "version": "1.0.0",
    "mvp_scope": "Gestión de ventas, gastos, tasa de cambio, recetas, costos de producción, ganancia bruta, dinero disponible y dashboard."
  },
  "architecture": {
    "type": "REST API",
    "pattern": "Modular monolith",
    "architecture_style": "Feature-based layered architecture",
    "api_prefix": "/api/v1",
    "documentation": "Swagger/OpenAPI",
    "authentication": "JWT access token and refresh token",
    "authorization": "Role-based access control prepared for future expansion",
    "language": "TypeScript"
  },
  "stack": {
    "runtime": "Node.js",
    "framework": "NestJS",
    "database": "MongoDB",
    "orm": "Prisma",
    "package_manager": "pnpm",
    "authentication": "JWT",
    "password_hashing": "Argon2 or bcrypt",
    "validation": "class-validator and class-transformer",
    "documentation": "Swagger",
    "testing": "Jest",
    "logging": "Structured application logging",
    "configuration": "@nestjs/config"
  },
  "business_context": {
    "business_name": "yukita Fit",
    "business_type": "Food production and sales",
    "main_products": "Yuca-based fit arepitas, sold individually or in packages",
    "base_currencies": [
      "USD",
      "VES"
    ],
    "default_currency": "USD",
    "default_package_quantity": 8,
    "initial_flavors": [
      "Natural",
      "Chía",
      "Pimentón",
      "Ahumado",
      "Al ajillo",
      "Zanahoria",
      "Remolacha",
      "Ají dulce",
      "Espinaca"
    ]
  },
  "mvp_principles": {
    "financial_indicators": {
      "sales": {
        "definition": "Total value of products sold during a selected period.",
        "formula": "sum(quantity × unit_price)"
      },
      "collected_sales": {
        "definition": "Total value of sales that have actually been collected.",
        "formula": "sum(collected amounts)"
      },
      "gross_profit": {
        "definition": "Revenue from sales minus the production cost of the products sold.",
        "formula": "sales revenue - cost of goods sold"
      },
      "available_money": {
        "definition": "Expected money in cash and accounts after collected sales, paid expenses and adjustments.",
        "formula": "opening balance + collected sales - paid expenses + adjustments"
      },
      "accounts_receivable": {
        "definition": "Sales registered but not fully collected.",
        "formula": "sales revenue - collected amounts"
      },
      "pending_expenses": {
        "definition": "Expenses registered but not yet paid.",
        "formula": "sum(pending expense amounts)"
      }
    },
    "important_rules": [
      "Sales, gross profit and available money must be calculated and displayed as separate indicators.",
      "A sale must not automatically be considered collected.",
      "A sale must not automatically be considered profit.",
      "Only collected sales affect available money.",
      "Only paid expenses affect available money.",
      "Pending sales must be visible as accounts receivable.",
      "Pending expenses must be visible as obligations but must not reduce available money until paid.",
      "Historical sales must preserve the production cost snapshot used at the time of sale.",
      "Historical transactions must preserve the exchange rate used at the time of registration.",
      "Financial calculations must use decimal values and never floating-point persistence."
    ]
  },
  "modules": [
    {
      "name": "auth",
      "scope": "mvp",
      "responsibilities": [
        "User registration",
        "User login",
        "Access token generation",
        "Refresh token generation",
        "Password hashing",
        "Session management"
      ]
    },
    {
      "name": "users",
      "scope": "mvp",
      "responsibilities": [
        "User profile",
        "Business owner information",
        "User preferences"
      ]
    },
    {
      "name": "dashboard",
      "scope": "mvp",
      "responsibilities": [
        "Sales summary",
        "Collected sales summary",
        "Paid expenses summary",
        "Gross profit summary",
        "Available money summary",
        "Accounts receivable summary",
        "Pending expenses summary",
        "Units sold summary",
        "Sales charts",
        "Expense charts",
        "Flavor sales charts",
        "Recent transactions",
        "Business alerts"
      ]
    },
    {

  "database_rules": {
    "numeric_types": [
      "NUMERIC",
      "DECIMAL"
    ],
    "never_use_float_for_financial_persistence": true,
    "required_historical_snapshots": [
      "Exchange rate used by each transaction",
      "Production cost used by each sale item",
      "Unit price used by each sale item",
      "Payment amounts",
      "Expense paid amounts"
    ],
    "transaction_integrity": [
      "Creating a sale and its sale items must be atomic.",
      "Registering a payment and its cash movement must be atomic.",
      "Registering an expense payment and its cash movement must be atomic.",
      "Creating a recipe cost snapshot must be atomic.",
      "Available money must not be calculated by simply adding all sales, because pending sales are excluded."
    ]
  },
  "financial_calculations": {
    "sales_revenue": "sum(saleItem.subtotal)",
    "collected_sales": "sum(payment.amount)",
    "cost_of_goods_sold": "sum(saleItem.totalProductionCost)",
    "gross_profit": "sales_revenue - cost_of_goods_sold",
    "accounts_receivable": "sales.total - sales.collectedAmount",
    "paid_expenses": "sum(expense.paidAmount)",
    "pending_expenses": "sum(expense.amount - expense.paidAmount)",
    "available_money": "opening_balances + collected_sales - paid_expenses + adjustments",
    "net_cash_flow": "collected_sales - paid_expenses + adjustments"
  },

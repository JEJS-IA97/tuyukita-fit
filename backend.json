      "scope": "mvp",
      "responsibilities": [
        "Register daily exchange rate",
        "Update current exchange rate",
        "List exchange rate history",
        "Register exchange rate source",
        "Support manual exchange rate input",
        "Prepare integration with BCV, USDT or another provider",
        "Preserve the exchange rate used by historical transactions"
      ]
    },
    {
      "name": "products",
      "scope": "mvp",
      "responsibilities": [
        "Create products",
        "Update products",
        "List products",
        "Activate or deactivate products",
        "Configure sales presentations",
        "Configure package quantity"
      ]
    },
    {
      "name": "flavors",
      "scope": "mvp",
      "responsibilities": [
        "Create flavors",
        "Update flavors",
        "List flavors",
        "Activate or deactivate flavors"
      ]
    },
    {
      "name": "ingredients",
      "scope": "mvp",
      "responsibilities": [
        "Create ingredients",
        "Update ingredients",
        "List ingredients",
        "Configure measurement units",
        "Register current ingredient cost",
        "Register ingredient purchases",
        "Maintain ingredient cost history"
      ]
    },
    {
      "name": "packaging",
      "scope": "mvp",
      "responsibilities": [
        "Create packaging items",
        "Update packaging items",
        "List packaging items",
        "Register current packaging cost",
        "Register packaging purchases",
        "Maintain packaging cost history"
      ]
    },
    {
      "name": "recipes",
      "scope": "mvp",
      "responsibilities": [
        "Create recipes",
        "Assign ingredients to recipes",
        "Assign packaging to recipes",
        "Configure recipe yield",
        "Calculate total recipe cost",
        "Calculate unit cost",
        "Calculate package cost",
        "Maintain recipe versions"
      ]
    },
    {
      "name": "product-costs",
      "scope": "mvp",
      "responsibilities": [
        "Calculate current product cost",
        "Create cost snapshots",
        "Calculate cost per unit",
        "Calculate cost per package",
        "Calculate estimated gross margin",
        "Preserve historical cost used by sales"
      ]
    },
    {
      "name": "sales",
      "scope": "mvp",
      "responsibilities": [
        "Register sales",
        "Register sale items",
        "Register collected amounts",
        "Register pending amounts",
        "Register partial collections",
        "Calculate sales revenue",
        "Calculate production cost of sold products",
        "Calculate gross profit",
        "List sales",
        "Filter sales by date, product, flavor and payment status"
      ]
    },
    {
      "name": "expenses",
      "scope": "mvp",
      "responsibilities": [
        "Register expenses",
        "Register paid expenses",
        "Register pending expenses",
        "Register partial payments",
        "Assign expense categories",
        "List expenses",
        "Filter expenses by date, category and payment status"
      ]
    },
    {
      "name": "cash-flow",
      "scope": "mvp",
      "responsibilities": [
        "Register opening balance",
        "Register paid income movements",
        "Register paid expense movements",
        "Register manual adjustments",
        "Calculate expected available money",
        "Separate cash and account balances conceptually",
        "List cash movements"
      ]
    },
    {
      "name": "reports",
      "scope": "mvp",
      "responsibilities": [
        "Sales report",
        "Collected sales report",
        "Expenses report",
        "Gross profit report",
        "Available money report",
        "Accounts receivable report",
        "Pending expenses report",
        "Sales by flavor",
        "Sales by month",
        "Expenses by category"
      ]
    },
    {
      "name": "settings",
      "scope": "mvp",
      "responsibilities": [
        "Business name",
        "Default currency",
        "Default package quantity",
        "Default exchange rate source",
        "Dashboard preferences"
      ]
    }
  ],
  "excluded_from_mvp": [
    "Full double-entry accounting",
    "Tax accounting automation",
    "Fiscal electronic invoicing",
    "Bank API integrations",
    "Advanced bank reconciliation",
    "Advanced accounts payable",
    "Advanced accounts receivable",
    "Production batch management",
    "Automatic raw material inventory deduction",
    "Advanced warehouse management",
    "Depreciation of equipment",
    "Payroll",
    "Multi-company accounting",
    "Accounting ledger",
    "Automated BCV integration if no stable provider is available"
